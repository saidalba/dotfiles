#
# ~/.bashrc
#

# If not running interactively, don't do anything
[[ $- != *i* ]] && return

alias ls='ls --color=auto'
alias grep='grep --color=auto'

# PS1='[\u@\h \W]\$ '
PS1="\[$(tput bold)\]\[$(tput setaf 48)\]\u\[$(tput setaf 15)\]@\[$(tput setaf 69)\]\h \[$(tput setaf 173)\]\w \[$(tput sgr0)\]$ "

# Default editor
export EDITOR='micro'
